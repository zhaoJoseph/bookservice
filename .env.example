# Copy to .env and fill in real values. Never commit .env itself.

# --- Auth (src/config.py) ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_HOURS=24

# --- Google OAuth ---
# Currently unused by src/ — no code reads CLIENT_ID/CLIENT_SECRET today.
# Keep only if you're wiring up Google sign-in.
CLIENT_ID=
CLIENT_SECRET=

# --- AWS / SES (src/aws/config.py) ---
# Note: the app reads AWS_REGION, not AWS_SES_REGION — double check your .env
# uses this exact name or it'll silently fall back to the us-east-1 default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SOURCE_EMAIL=verified-sender@example.com
S3_BUCKET=your-s3-bucket-name

# --- Book file storage (src/books/router.py) ---
GOOGLE_PDF_BUCKET=
GOOGLE_EPUB_BUCKET=

# --- Database (src/database.py) ---
# Defaults to local SQLite if unset.
DATABASE_URL=sqlite+aiosqlite:///./bookservice.db

# --- Third-party API keys ---
# Not currently read anywhere in src/ (langchain/pinecone/groq deps are
# unused today) — set these only once that integration is wired up.
PINECONE_API_KEY=
GROQ_API_KEY=

# --- Test/CI ---
# Set automatically by tests/conftest.py; only needed if you run the app
# (not the test suite) against a non-dev environment locally.
TESTING=
